# Network access happens only while configuring a Windows developer build.
# Runtime UI/telemetry does not use the network. Versions are deliberately pinned.
set(PULSEVIEW_WEBVIEW2_VERSION "1.0.3537.50" CACHE STRING "Pinned stable WebView2 SDK")
set(PULSEVIEW_WEBVIEW2_DIR "" CACHE PATH "Offline extracted Microsoft.Web.WebView2 package")
set(PULSEVIEW_JSON_INCLUDE_DIR "" CACHE PATH "Offline directory containing nlohmann/json.hpp")
set(PULSEVIEW_ALLOW_DOWNLOADS ON CACHE BOOL "Fetch missing pinned build dependencies over HTTPS")

function(pulse_download url destination)
  if(EXISTS "${destination}")
    return()
  endif()
  if(NOT PULSEVIEW_ALLOW_DOWNLOADS)
    message(FATAL_ERROR "Missing ${destination}. Supply offline dependency paths or enable PULSEVIEW_ALLOW_DOWNLOADS.")
  endif()
  get_filename_component(parent "${destination}" DIRECTORY)
  file(MAKE_DIRECTORY "${parent}")
  message(STATUS "Downloading pinned build dependency: ${url}")
  file(DOWNLOAD "${url}" "${destination}.part" TLS_VERIFY ON STATUS status TIMEOUT 180)
  list(GET status 0 code)
  list(GET status 1 reason)
  if(NOT code EQUAL 0)
    file(REMOVE "${destination}.part")
    message(FATAL_ERROR "Dependency download failed: ${reason}\nUse the offline instructions in README.md; do not disable TLS verification.")
  endif()
  file(RENAME "${destination}.part" "${destination}")
endfunction()

if(NOT PULSEVIEW_JSON_INCLUDE_DIR)
  set(PULSEVIEW_JSON_INCLUDE_DIR "${CMAKE_BINARY_DIR}/_deps/json-3.12.0/include")
  pulse_download("https://raw.githubusercontent.com/nlohmann/json/v3.12.0/single_include/nlohmann/json.hpp"
    "${PULSEVIEW_JSON_INCLUDE_DIR}/nlohmann/json.hpp")
  pulse_download("https://raw.githubusercontent.com/nlohmann/json/v3.12.0/LICENSE.MIT"
    "${CMAKE_BINARY_DIR}/_deps/json-3.12.0/LICENSE.MIT")
endif()
if(NOT EXISTS "${PULSEVIEW_JSON_INCLUDE_DIR}/nlohmann/json.hpp")
  message(FATAL_ERROR "PULSEVIEW_JSON_INCLUDE_DIR must contain nlohmann/json.hpp")
endif()

if(NOT PULSEVIEW_WEBVIEW2_DIR)
  set(PULSEVIEW_WEBVIEW2_DIR "${CMAKE_BINARY_DIR}/_deps/webview2-${PULSEVIEW_WEBVIEW2_VERSION}")
  if(NOT EXISTS "${PULSEVIEW_WEBVIEW2_DIR}/build/native/include/WebView2.h")
    set(archive "${CMAKE_BINARY_DIR}/_deps/webview2-${PULSEVIEW_WEBVIEW2_VERSION}.zip")
    pulse_download("https://api.nuget.org/v3-flatcontainer/microsoft.web.webview2/${PULSEVIEW_WEBVIEW2_VERSION}/microsoft.web.webview2.${PULSEVIEW_WEBVIEW2_VERSION}.nupkg" "${archive}")
    file(MAKE_DIRECTORY "${PULSEVIEW_WEBVIEW2_DIR}")
    file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${PULSEVIEW_WEBVIEW2_DIR}")
  endif()
endif()
set(PULSEVIEW_WEBVIEW2_INCLUDE "${PULSEVIEW_WEBVIEW2_DIR}/build/native/include")
set(PULSEVIEW_WEBVIEW2_LOADER "${PULSEVIEW_WEBVIEW2_DIR}/build/native/x64/WebView2LoaderStatic.lib")
if(NOT EXISTS "${PULSEVIEW_WEBVIEW2_INCLUDE}/WebView2.h" OR NOT EXISTS "${PULSEVIEW_WEBVIEW2_LOADER}")
  message(FATAL_ERROR "Invalid WebView2 SDK extraction. Expected build/native/include and build/native/x64/WebView2LoaderStatic.lib. See README.md.")
endif()
