#include <windows.h>
#include "Version.h"
101 ICON "app.ico"
1 RT_MANIFEST "app.manifest"
1 VERSIONINFO
 FILEVERSION PULSEVIEW_VERSION_COMMA
 PRODUCTVERSION PULSEVIEW_VERSION_COMMA
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904B0"
  BEGIN
   VALUE "FileDescription", "PulseView Modular Performance Monitor\0"
   VALUE "FileVersion", PULSEVIEW_VERSION "\0"
   VALUE "ProductName", "PulseView\0"
   VALUE "ProductVersion", PULSEVIEW_VERSION "\0"
   VALUE "OriginalFilename", "PulseView.exe\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END
