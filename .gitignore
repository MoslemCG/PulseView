# Root ownership: new source files inside these trees are welcome automatically.
# Unclassified top-level folders stay local until intentionally assigned a role.
/*
!/.editorconfig
!/.gitattributes
!/.gitignore
!/.githooks/
!/.github/
!/.vscode/
!/AGENTS.md
!/agent.md
!/README.md
!/README.fa.md
!/CHANGELOG.md
!/LICENSE
!/SECURITY.md
!/THIRD_PARTY_NOTICES.md
!/SOURCE_MANIFEST.json
!/CMakeLists.txt
!/CMakePresets.json
!/package.json
!/package-lock.json
!/build.cmd
!/cmake/
!/docs/
!/examples/
!/native/
!/scripts/
!/tests/
!/ui/

# Generated/local directories are excluded at ANY depth, including source trees.
out/
build/
dist/
node_modules/
.local/
scratch/
tmp/
temp/
artifacts/
test-results/
coverage/
.venv/
venv/
.pytest_cache/
.cache/
CMakeFiles/
CMakeCache.txt
/out/
/build/
/node_modules/
*.user
.vs/
__pycache__/
*.pyc
playwright-report/
.env
# Local configuration and credentials (never force-add these).
.env.*
*.pem
*.key
*.p12
*.pfx
*.jks
.npmrc
.netrc
credentials*.json
secrets*.json

# Workstation/editor state, native binaries and diagnostic output.
*.lnk
*.url
*.log
*.log.*
*.dmp
*.pdb
*.exe
*.dll
*.obj
*.lib
*.ilk
*.bak
*.tmp
*.zip
*.7z
.idea/
.codex/
.DS_Store
Thumbs.db
CMakeUserPresets.json
/dist/
/test-results/

# Runtime state is private, even when copied into the checkout.
WebView2/
/presets/
exports/
session.json
session.json.bak
/PulseView/

# Supplied references have no established public redistribution grant.
# Retain the local originals; publish the project's actual screenshots instead.
/docs/design/*.png
